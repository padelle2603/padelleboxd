# Database (Supabase Postgres) — TRANSACTION mode via Shared Pooler (port 6543, pgbouncer=true).
# In transaction mode the pooler returns the connection to the pool when the transaction ends: required
# on Vercel/serverless, where the session pooler (port 5432, 15-connection limit) saturates
# quickly with warm instances. `uselibpqcompat=true` skips CA verification for the pooler's
# private CA.
# From the Supabase dashboard use "Transaction pooler" (port 6543): host `aws-N-<region>.pooler.supabase.com`,
# user `postgres.<project-ref>`.
DATABASE_URL="postgresql://postgres.YOURPROJECTREF:your_supabase_password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true&pgbouncer=true"

# TMDB API
TMDB_READ_ACCESS_TOKEN="your_tmdb_read_access_token_here"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"

# Session secret — use a long random string in production
SESSION_SECRET="change-me-to-a-long-random-string"

# Admin bootstrap (used by `npx prisma db seed`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme123"

# Admin panel access — comma-separated IP allowlist (only these machines can use /admin).
# Leave empty to allow any ADMIN role.
# ADMIN_ALLOWED_IPS="203.0.113.10,192.168.1.58"